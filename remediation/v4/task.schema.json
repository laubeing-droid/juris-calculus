{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jc/remediation-v4-task/2.0",
  "title": "Remediation V4 executable task plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"const": "jc/remediation-v4-task/2.0"},
    "baseline": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "commit": {"type": "string"}, "tree": {"type": "string"},
        "plan_sha256": {"type": "string"}, "audit_sha256": {"type": "string"}
      }
    },
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "assertion": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["all_commands_passed", "path_exists", "path_absent", "git_tracked", "git_untracked", "command"]},
        "path": {"type": "string"}, "argv": {"$ref": "#/$defs/argv"},
        "expected_exit_code": {"type": "integer"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_kind", "gate_id", "subject", "subject_paths", "required_roles", "allowed_scopes", "minimum_signers", "separation_of_duties"],
      "properties": {
        "evidence_kind": {"enum": ["USER_DIRECTIVE", "CRYPTOGRAPHIC_SIGNATURE", "EXTERNAL_ARTIFACT"]},
        "gate_id": {"type": "string"}, "subject": {"type": "string"},
        "subject_paths": {"type": "array", "items": {"type": "string"}},
        "required_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "allowed_scopes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "minimum_signers": {"type": "integer", "minimum": 1},
        "separation_of_duties": {"type": "boolean"},
        "separation_from_tasks": {"type": "array", "items": {"type": "string"}}
      }
    },
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "wave", "mode", "depends_on", "objective", "allowed_paths"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9-]+$"}, "wave": {"type": "string"},
        "mode": {"enum": ["AUTO", "HUMAN_GATE", "EXTERNAL_GATE", "MIXED"]},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "audit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "objective": {"type": "string", "minLength": 1},
        "allowed_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}},
        "argv": {"type": "array", "items": {"$ref": "#/$defs/argv"}},
        "expected_exit_codes": {"type": "array", "items": {"type": "integer"}},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "completion_assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
        "rollback": {"type": "string", "minLength": 1},
        "required_receipt_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "approval": {"$ref": "#/$defs/approval"},
        "terminal_states": {"type": "array", "items": {"type": "string"}},
        "commit_type": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"properties": {"mode": {"const": "AUTO"}}, "required": ["mode"]},
              {
                "properties": {
                  "mode": {"const": "MIXED"},
                  "argv": {"minItems": 1}
                },
                "required": ["mode", "argv"]
              }
            ]
          },
          "then": {
            "required": ["argv", "expected_exit_codes", "completion_assertions", "rollback", "required_receipt_fields"],
            "properties": {"argv": {"minItems": 1}, "completion_assertions": {"minItems": 1}}
          }
        },
        {
          "if": {"properties": {"mode": {"enum": ["HUMAN_GATE", "EXTERNAL_GATE", "MIXED"]}}, "required": ["mode"]},
          "then": {"required": ["approval"]}
        }
      ]
    }
  }
}
