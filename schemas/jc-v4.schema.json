{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juris-calculus.local/schema/jc-v4.schema.json",
  "title": "JCV4Contracts",
  "description": "JC v4 唯一 JSON authority。与 compiler_core.contracts_v4 字段一一对应；round-trip 测试强制。v3/W1b 只能通过 compat adapter 投影到本合同。",
  "oneOf": [
    { "$ref": "#/$defs/CaseRequestV4" },
    { "$ref": "#/$defs/SemanticResultV4" }
  ],
  "$defs": {
    "sha256_digest": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    },
    "canonical_time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "description": "RFC3339 UTC 规范时间；非规范时间 fail closed"
    },
    "ref_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!([A-Za-z]:[\\\\/]|\\\\\\\\|/)).*$",
      "description": "引用 ID；禁止绝对机器路径"
    },
    "CaseRequestV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "schema_version",
        "legal_context",
        "decision_time",
        "source_bundle_ref",
        "evidence_manifest_ref",
        "fact_attestation_refs",
        "rule_pack_ref",
        "requested_outputs"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/ref_id" },
        "schema_version": { "type": "string", "const": "jc/4.0" },
        "legal_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jurisdiction", "governing_law"],
          "properties": {
            "jurisdiction": { "$ref": "#/$defs/ref_id" },
            "governing_law": { "$ref": "#/$defs/ref_id" }
          }
        },
        "decision_time": { "$ref": "#/$defs/canonical_time" },
        "source_bundle_ref": { "$ref": "#/$defs/ref_id" },
        "evidence_manifest_ref": { "$ref": "#/$defs/ref_id" },
        "fact_attestation_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref_id" },
          "uniqueItems": true,
          "maxItems": 512
        },
        "rule_pack_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pack_id", "version", "digest"],
          "properties": {
            "pack_id": { "$ref": "#/$defs/ref_id" },
            "version": { "$ref": "#/$defs/ref_id" },
            "digest": { "$ref": "#/$defs/sha256_digest" }
          }
        },
        "requested_outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "semantic_result",
              "checker_receipt",
              "solver_receipt",
              "translation_receipt",
              "certificate",
              "audit_bundle",
              "replay"
            ]
          }
        },
        "proposal_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ref_id" },
          "uniqueItems": true,
          "maxItems": 512
        }
      }
    },
    "SemanticResultV4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "schema_version",
        "decision_status",
        "admitted_fact_refs",
        "rejected_fact_refs",
        "applicable_rule_refs",
        "inapplicable_rule_refs",
        "argument_refs",
        "attack_refs",
        "exception_resolution",
        "permission_resolution",
        "priority_resolution",
        "temporal_numeric_result",
        "receipt_refs",
        "completeness_state",
        "interruption_state",
        "run_identity"
      ],
      "properties": {
        "request_id": { "$ref": "#/$defs/ref_id" },
        "schema_version": { "type": "string", "const": "jc/4.0" },
        "decision_status": {
          "type": "string",
          "enum": [
            "accepted_formal_result",
            "hypothetical_result",
            "review_only_result",
            "missing_required_fact",
            "conflict_certificate",
            "blocked",
            "unknown",
            "engine_error"
          ]
        },
        "admitted_fact_refs": { "type": "array", "items": { "$ref": "#/$defs/ref_id" }, "uniqueItems": true },
        "rejected_fact_refs": { "type": "array", "items": { "$ref": "#/$defs/ref_id" }, "uniqueItems": true },
        "applicable_rule_refs": { "type": "array", "items": { "$ref": "#/$defs/ref_id" }, "uniqueItems": true },
        "inapplicable_rule_refs": { "type": "array", "items": { "$ref": "#/$defs/ref_id" }, "uniqueItems": true },
        "argument_refs": { "type": "array", "items": { "$ref": "#/$defs/ref_id" }, "uniqueItems": true },
        "attack_refs": { "type": "array", "items": { "$ref": "#/$defs/ref_id" }, "uniqueItems": true },
        "exception_resolution": { "type": "object" },
        "permission_resolution": { "type": "object" },
        "priority_resolution": { "type": "object" },
        "temporal_numeric_result": { "type": "object" },
        "receipt_refs": { "type": "array", "items": { "$ref": "#/$defs/ref_id" }, "uniqueItems": true },
        "completeness_state": {
          "type": "string",
          "enum": ["complete", "partial", "truncated", "interrupted"]
        },
        "interruption_state": { "type": "string", "minLength": 1 },
        "run_identity": { "type": "object", "minProperties": 1 }
      }
    }
  }
}
