{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juris-calculus.local/schema/w1b/rule-admission-request.schema.json",
  "title": "JCRuleAdmissionRequest",
  "description": "JC 规则准入请求（W1b 正式合同）：只接受 LCCC SnapshotVerificationReceipt、快照成员 locator 与 LegalOS FactApprovalRef；不读另三产品数据库。",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "snapshot_verification_receipt", "fact_approval_ref", "locator", "requested_at"],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "snapshot_verification_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "manifest_id", "manifest_digest", "result", "verified_at"],
      "properties": {
        "receipt_id": { "type": "string", "minLength": 1 },
        "manifest_id": { "type": "string", "minLength": 1 },
        "manifest_digest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "result": { "type": "string", "enum": ["verified", "tampered", "partial", "unknown"] },
        "verified_at": { "type": "string" },
        "failure_reason": { "type": "string" }
      }
    },
    "fact_approval_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_id", "fact_claim_id", "approved_at"],
      "properties": {
        "ref_id": { "type": "string", "minLength": 1 },
        "fact_claim_id": { "type": "string", "minLength": 1 },
        "evidence_anchor_refs": { "type": "array", "items": { "type": "string" } },
        "approved_at": { "type": "string" }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "snapshot", "ref", "digest"],
      "properties": {
        "owner": { "type": "string", "enum": ["lccc", "legalos"] },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest_id", "digest"],
          "properties": {
            "manifest_id": { "type": "string" },
            "digest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" }
          }
        },
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "type": "string", "enum": ["relative_path", "object_id", "law_id_article", "case_id"] },
            "value": { "type": "string" },
            "page": { "type": "integer", "minimum": 1 },
            "span": {
              "type": "object",
              "additionalProperties": false,
              "required": ["start", "end"],
              "properties": {
                "start": { "type": "integer", "minimum": 0 },
                "end": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "digest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "page_map_status": { "type": "string", "enum": ["VERIFIED", "PAGE_MAP_UNVERIFIED"] }
      }
    },
    "requested_at": { "type": "string" }
  }
}
