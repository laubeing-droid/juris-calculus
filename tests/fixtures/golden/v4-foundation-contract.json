{
  "schema_version": "jc/v4-foundation-contract/1.0",
  "digest_policy": {
    "algorithm": "sha256",
    "wire_prefix": "sha256:",
    "grammar": "^sha256:[0-9a-f]{64}$"
  },
  "time_policy": {
    "wire_profile": "UTC_Z_RFC3339_NANOSECOND_CANONICAL",
    "precision": "nanosecond",
    "comparison": "epoch_seconds_then_nanosecond",
    "interval_semantics": "[start,end)",
    "positive": [
      {"id": "epoch", "wire": "1970-01-01T00:00:00Z", "epoch_seconds": 0, "nanosecond": 0},
      {"id": "one-nanosecond", "wire": "1970-01-01T00:00:00.000000001Z", "epoch_seconds": 0, "nanosecond": 1},
      {"id": "pre-epoch", "wire": "1969-12-31T23:59:59.999999999Z", "epoch_seconds": -1, "nanosecond": 999999999},
      {"id": "leap-day-nanoseconds", "wire": "2024-02-29T12:34:56.123456789Z", "epoch_seconds": 1709210096, "nanosecond": 123456789}
    ],
    "negative": [
      {"id": "offset", "wire": "2024-01-01T00:00:00+00:00", "expected_error": "INVALID_CANONICAL_TIME"},
      {"id": "lowercase-z", "wire": "2024-01-01T00:00:00z", "expected_error": "INVALID_CANONICAL_TIME"},
      {"id": "missing-seconds", "wire": "2024-01-01T00:00Z", "expected_error": "INVALID_CANONICAL_TIME"},
      {"id": "empty-fraction", "wire": "2024-01-01T00:00:00.Z", "expected_error": "INVALID_CANONICAL_TIME"},
      {"id": "too-many-fraction-digits", "wire": "2024-01-01T00:00:00.1234567890Z", "expected_error": "INVALID_CANONICAL_TIME"},
      {"id": "trailing-fraction-zero", "wire": "2024-01-01T00:00:00.10Z", "expected_error": "NON_CANONICAL_TIME"},
      {"id": "leap-second", "wire": "2016-12-31T23:59:60Z", "expected_error": "INVALID_CALENDAR_TIME"},
      {"id": "invalid-leap-day", "wire": "2023-02-29T00:00:00Z", "expected_error": "INVALID_CALENDAR_TIME"},
      {"id": "hour-24", "wire": "2024-01-01T24:00:00Z", "expected_error": "INVALID_CALENDAR_TIME"}
    ],
    "interval_vectors": [
      {
        "id": "half-open-boundaries",
        "start": "2024-01-01T00:00:00Z",
        "end": "2024-02-01T00:00:00Z",
        "probes": [
          {"instant": "2023-12-31T23:59:59.999999999Z", "contains": false},
          {"instant": "2024-01-01T00:00:00Z", "contains": true},
          {"instant": "2024-01-31T23:59:59.999999999Z", "contains": true},
          {"instant": "2024-02-01T00:00:00Z", "contains": false}
        ]
      }
    ]
  },
  "numeric_policy": {
    "safe_integer": {"minimum": -9007199254740991, "maximum": 9007199254740991, "float_allowed": false},
    "money": {"fields": ["currency", "minor_units"], "currency_grammar": "^[A-Z]{3}$", "amount_unit": "minor_unit"},
    "rational": {"fields": ["numerator", "denominator"], "denominator": "positive", "normal_form": "gcd=1;zero=0/1"},
    "positive": [
      {"id": "integer-min", "kind": "integer", "value": -9007199254740991},
      {"id": "integer-max", "kind": "integer", "value": 9007199254740991},
      {"id": "money-zero", "kind": "money", "value": {"currency": "CNY", "minor_units": 0}},
      {"id": "money-negative", "kind": "money", "value": {"currency": "USD", "minor_units": -1}},
      {"id": "rational-third", "kind": "rational", "value": {"numerator": 1, "denominator": 3}},
      {"id": "rational-negative-half", "kind": "rational", "value": {"numerator": -1, "denominator": 2}},
      {"id": "rational-zero", "kind": "rational", "value": {"numerator": 0, "denominator": 1}}
    ],
    "negative": [
      {"id": "unsafe-high", "kind": "integer", "value": 9007199254740992, "expected_error": "UNSAFE_INTEGER"},
      {"id": "unsafe-low", "kind": "integer", "value": -9007199254740992, "expected_error": "UNSAFE_INTEGER"},
      {"id": "float", "kind": "integer", "value": 1.5, "expected_error": "FLOAT_FORBIDDEN"},
      {"id": "money-float", "kind": "money", "value": {"currency": "CNY", "minor_units": 0.01}, "expected_error": "FLOAT_FORBIDDEN"},
      {"id": "money-lowercase-currency", "kind": "money", "value": {"currency": "cny", "minor_units": 1}, "expected_error": "CURRENCY_CODE"},
      {"id": "money-extra-field", "kind": "money", "value": {"currency": "CNY", "minor_units": 1, "major_units": 0}, "expected_error": "UNKNOWN_FIELD"},
      {"id": "rational-zero-denominator", "kind": "rational", "value": {"numerator": 1, "denominator": 0}, "expected_error": "DENOMINATOR_NONPOSITIVE"},
      {"id": "rational-negative-denominator", "kind": "rational", "value": {"numerator": 1, "denominator": -2}, "expected_error": "DENOMINATOR_NONPOSITIVE"},
      {"id": "rational-unreduced", "kind": "rational", "value": {"numerator": 2, "denominator": 4}, "expected_error": "NON_CANONICAL_RATIONAL"},
      {"id": "rational-zero-not-normalized", "kind": "rational", "value": {"numerator": 0, "denominator": 2}, "expected_error": "NON_CANONICAL_RATIONAL"}
    ]
  },
